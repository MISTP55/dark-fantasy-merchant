<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="InfoPanel.uss" />
    <Style src="CityInfoPanel.uss" />
    <ui:VisualElement name="map-ui-root" picking-mode="Ignore" class="map-ui-root">
        <ui:Label name="hover-label" picking-mode="Ignore" class="hover-label" />
        <ui:VisualElement name="city-panel" class="info-panel city-panel">
            <ui:VisualElement class="info-panel__header">
                <ui:Label name="city-name" class="info-panel__name" />
                <ui:VisualElement class="info-panel__buttons">
                    <ui:Button name="view-city-button" text="Voir la ville" class="info-panel__action" />
                    <ui:Button name="close-button" text="X" class="info-panel__close" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="city-panel__body">
                <ui:ScrollView name="city-scroll" class="city-panel__city">
                    <ui:Label name="city-size" class="city-panel__tag" />
                    <ui:Label name="city-access" class="city-panel__tag" />
                    <ui:Label name="city-population" class="city-panel__tag" />
                    <ui:Label name="city-description" class="city-panel__description" />
                    <ui:Label text="Production efficace" class="city-panel__section" />
                    <ui:Label name="efficient-goods" class="city-panel__goods" />
                    <ui:Label text="Production inefficace" class="city-panel__section" />
                    <ui:Label name="inefficient-goods" class="city-panel__goods" />
                </ui:ScrollView>
                <ui:VisualElement class="city-panel__tabs-side">
                    <ui:VisualElement class="city-panel__tab-bar">
                        <ui:Button name="tab-market" text="Marché" class="city-panel__tab" />
                        <ui:Button name="tab-transfer" text="Transfert" class="city-panel__tab" />
                        <ui:Button name="tab-ships" class="city-panel__tab" />
                    </ui:VisualElement>
                    <ui:VisualElement name="market-page" class="city-panel__page">
                        <ui:VisualElement name="market-section" class="market">
                            <ui:VisualElement name="ship-line" class="market__ship-line">
                                <ui:Label text="Avec :" class="market__ship-label" />
                                <ui:DropdownField name="trading-ship" class="market__ship-choice" />
                                <ui:Label name="market-hold" class="market__hold" />
                            </ui:VisualElement>
                            <ui:VisualElement class="market__row market__row--header">
                                <ui:VisualElement class="market__icon" />
                                <ui:Label text="Marchandise" class="market__cell market__cell--name" />
                                <ui:Label text="Stock" class="market__cell market__cell--number" />
                                <ui:Label text="Achat" class="market__cell market__cell--price" />
                                <ui:Label text="Vente" class="market__cell market__cell--price" />
                                <ui:Label name="market-store-header" text="Cale" class="market__cell market__cell--number market__cell--trade" />
                            </ui:VisualElement>
                            <ui:ScrollView class="market__scroll">
                                <ui:VisualElement name="market-rows" />
                            </ui:ScrollView>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="transfer-page" class="city-panel__page">
                        <ui:VisualElement name="transfer-section" class="market transfer">
                            <ui:VisualElement class="market__ship-line">
                                <ui:Label text="Navire :" class="market__ship-label" />
                                <ui:DropdownField name="transfer-ship" class="market__ship-choice" />
                            </ui:VisualElement>
                            <ui:VisualElement class="market__row market__row--header">
                                <ui:VisualElement class="market__icon" />
                                <ui:Label text="Marchandise" class="market__cell market__cell--name" />
                                <ui:Label name="transfer-hold-header" text="Cale" class="market__cell market__cell--number" />
                                <ui:Label text="" class="market__cell transfer__moves-header" />
                                <ui:Label text="Comptoir" class="market__cell market__cell--number" />
                            </ui:VisualElement>
                            <ui:ScrollView class="market__scroll">
                                <ui:Label name="no-transfer-ship" text="Aucun navire" class="city-panel__empty" />
                                <ui:VisualElement name="transfer-rows" />
                            </ui:ScrollView>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="ships-page" class="city-panel__page">
                        <ui:ScrollView class="city-panel__ships-scroll">
                            <ui:Label name="no-ship-label" text="Aucun navire" class="city-panel__empty" />
                            <ui:VisualElement name="ship-list" />
                        </ui:ScrollView>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
