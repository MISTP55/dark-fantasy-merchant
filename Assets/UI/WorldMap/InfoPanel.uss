/* The frame, title and close button shared by the city panel and the ship panel. */
.info-panel {
    width: 340px;
    padding: 16px;
    background-color: rgba(24, 17, 12, 0.94);
    border-width: 2px;
    border-color: rgb(110, 84, 52);
}

.info-panel__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.info-panel__name {
    flex-shrink: 1;
    color: rgb(240, 226, 196);
    font-size: 24px;
    -unity-font-style: bold;
    white-space: normal;
}

.info-panel__close {
    width: 28px;
    height: 28px;
    margin: 0;
    padding: 0;
}
