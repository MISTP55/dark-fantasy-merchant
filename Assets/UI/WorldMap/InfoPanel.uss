/* The frame, title and header buttons shared by the city panel, the ship panel and the debug panel. */
.info-panel {
    width: 340px;
    padding: 16px;
    background-color: rgba(24, 17, 12, 0.94);
    border-width: 2px;
    border-color: rgb(110, 84, 52);
}

.info-panel__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.info-panel__name {
    flex-shrink: 1;
    color: rgb(240, 226, 196);
    font-size: 24px;
    -unity-font-style: bold;
    white-space: normal;
}

/* The buttons of the header: the actions of the panel, then the close button. */
.info-panel__buttons {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.info-panel__action {
    height: 28px;
    margin: 0 8px 0 0;
    padding: 0 8px;
}

.info-panel__close {
    width: 28px;
    height: 28px;
    margin: 0;
    padding: 0;
}

/* In the colours of the panels, not the theme's grey. Prefixed by the panel: the theme's own
   hover and active rules add :enabled and would win otherwise. */
.info-panel .info-panel__action,
.info-panel .info-panel__close {
    color: rgb(222, 210, 188);
    background-color: rgba(60, 44, 30, 0.9);
    border-width: 1px;
    border-radius: 0;
    border-color: rgb(110, 84, 52);
    font-size: 14px;
}

.info-panel .info-panel__action:hover:enabled,
.info-panel .info-panel__close:hover:enabled {
    color: rgb(240, 226, 196);
    background-color: rgb(84, 62, 40);
    border-color: rgb(110, 84, 52);
}

.info-panel .info-panel__action:active:enabled,
.info-panel .info-panel__close:active:enabled {
    background-color: rgb(110, 84, 52);
}

/* Every other row of a list, from the second, is slightly lighter (set by ListStripes: USS
   has no :nth-child). Shared by the city panel, the ship panel and the debug panel. */
.list-row--alternate {
    background-color: rgba(240, 226, 196, 0.01);
}
