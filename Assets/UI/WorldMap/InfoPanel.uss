/* The frame, title and close button shared by the city panel and the ship panel. */
.info-panel {
    width: 340px;
    padding: 16px;
    background-color: rgba(24, 17, 12, 0.94);
    border-width: 2px;
    border-color: rgb(110, 84, 52);
}

.info-panel__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.info-panel__name {
    flex-shrink: 1;
    color: rgb(240, 226, 196);
    font-size: 24px;
    -unity-font-style: bold;
    white-space: normal;
}

/* The buttons of the header: the actions of the panel, then the close button. */
.info-panel__buttons {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
}

.info-panel__action {
    height: 28px;
    margin: 0 8px 0 0;
    padding: 0 8px;
}

.info-panel__close {
    width: 28px;
    height: 28px;
    margin: 0;
    padding: 0;
}

/* Every other row of a list, from the second, is slightly lighter (set by ListStripes: USS
   has no :nth-child). Shared by the city panel, the ship panel and the debug panel. */
.list-row--alternate {
    background-color: rgba(240, 226, 196, 0.01);
}
