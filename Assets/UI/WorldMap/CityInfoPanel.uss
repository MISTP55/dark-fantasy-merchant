/* The city panel's frame, title and close button are in InfoPanel.uss. */

/* Centers the city panel on the screen: the top right corner belongs to the treasury. */
.map-ui-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.hover-label {
    position: absolute;
    padding: 2px 8px;
    color: rgb(240, 226, 196);
    background-color: rgba(20, 14, 10, 0.85);
    border-width: 1px;
    border-color: rgb(110, 84, 52);
    font-size: 16px;
    -unity-font-style: bold;
}

.city-panel__tag {
    color: rgb(190, 164, 120);
    font-size: 14px;
}

.city-panel__description {
    margin-top: 12px;
    color: rgb(222, 210, 188);
    font-size: 15px;
    white-space: normal;
}

.city-panel__section {
    margin-top: 16px;
    margin-bottom: 4px;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: rgb(110, 84, 52);
    color: rgb(240, 226, 196);
    font-size: 16px;
    -unity-font-style: bold;
}

.city-panel__empty {
    color: rgb(140, 124, 100);
    font-size: 14px;
    -unity-font-style: italic;
}

.city-panel__ship {
    margin: 2px 0;
    padding: 6px 8px;
    color: rgb(222, 210, 188);
    background-color: rgba(60, 44, 30, 0.9);
    border-width: 1px;
    border-radius: 0;
    border-color: rgb(110, 84, 52);
    font-size: 15px;
    -unity-text-align: middle-left;
}

.city-panel__ship:hover {
    background-color: rgb(84, 62, 40);
}

.city-panel__ship:active {
    background-color: rgb(110, 84, 52);
}

.city-panel__ship--selected,
.city-panel__ship--selected:hover {
    color: rgb(24, 17, 12);
    background-color: rgb(255, 140, 51);
    border-color: rgb(240, 226, 196);
}

/* Wider than the ship panel: the market is a table. */
.city-panel {
    width: 480px;
}

.market__title {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.market__hold {
    color: rgb(190, 164, 120);
    font-size: 14px;
    -unity-font-style: normal;
}

.market__row {
    flex-direction: row;
    align-items: center;
    height: 26px;
}

.market__row--header {
    color: rgb(190, 164, 120);
}

.market__cell {
    margin: 0;
    padding: 0;
    color: rgb(222, 210, 188);
    font-size: 14px;
}

.market__row--header .market__cell {
    color: rgb(190, 164, 120);
    font-size: 13px;
}

.market__cell--name {
    flex-grow: 1;
    flex-shrink: 1;
}

.market__cell--number {
    width: 62px;
    -unity-text-align: middle-right;
}

/* The hold column and the buttons only exist while a ship in port trades. */
.market__cell--trade {
    display: none;
}

.market--trading .market__cell--trade {
    display: flex;
}

.market__button {
    width: 26px;
    height: 22px;
    margin: 0 0 0 6px;
    padding: 0;
    color: rgb(222, 210, 188);
    background-color: rgba(60, 44, 30, 0.9);
    border-width: 1px;
    border-radius: 0;
    border-color: rgb(110, 84, 52);
    font-size: 15px;
    -unity-font-style: bold;
}

.market__button:hover {
    background-color: rgb(84, 62, 40);
}

.market__button:active {
    background-color: rgb(110, 84, 52);
}

.market__button:disabled {
    opacity: 0.35;
}

/* As wide as the two buttons of a row and their margins. */
.market__buttons-space {
    width: 64px;
}
