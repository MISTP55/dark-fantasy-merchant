/* The city panel's frame, title and close button are in InfoPanel.uss. */

/* Centers the city panel on the screen: the top right corner belongs to the treasury. */
.map-ui-root {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
}

.hover-label {
    position: absolute;
    padding: 2px 8px;
    color: rgb(240, 226, 196);
    background-color: rgba(20, 14, 10, 0.85);
    border-width: 1px;
    border-color: rgb(110, 84, 52);
    font-size: 16px;
    -unity-font-style: bold;
}

.city-panel__tag {
    color: rgb(190, 164, 120);
    font-size: 14px;
}

.city-panel__description {
    margin-top: 12px;
    color: rgb(222, 210, 188);
    font-size: 15px;
    white-space: normal;
}

.city-panel__section {
    margin-top: 16px;
    margin-bottom: 4px;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: rgb(110, 84, 52);
    color: rgb(240, 226, 196);
    font-size: 16px;
    -unity-font-style: bold;
}

.city-panel__goods {
    color: rgb(222, 210, 188);
    font-size: 15px;
    white-space: normal;
}

.city-panel__empty {
    color: rgb(140, 124, 100);
    font-size: 14px;
    -unity-font-style: italic;
}

.city-panel__ship {
    margin: 2px 0;
    padding: 6px 8px;
    color: rgb(222, 210, 188);
    background-color: rgba(60, 44, 30, 0.9);
    border-width: 1px;
    border-radius: 0;
    border-color: rgb(110, 84, 52);
    font-size: 15px;
    -unity-text-align: middle-left;
}

/* Before the hover and the press, which win over it. */
.city-panel__ship.list-row--alternate {
    background-color: rgba(66, 48, 33, 0.9);
}

.city-panel__ship:hover {
    background-color: rgb(84, 62, 40);
}

.city-panel__ship:active {
    background-color: rgb(110, 84, 52);
}

.city-panel__ship--selected,
.city-panel__ship--selected.list-row--alternate,
.city-panel__ship--selected:hover {
    color: rgb(24, 17, 12);
    background-color: rgb(255, 140, 51);
    border-color: rgb(240, 226, 196);
}

/* A fixed size, well under the height of the screen: the city on the left, three tabs on
   the right. Only the content of a tab, or a long description, scrolls. */
.city-panel {
    width: 900px;
    height: 664px;
}

.city-panel > .info-panel__header {
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(110, 84, 52);
}

.city-panel__body {
    flex-direction: row;
    flex-grow: 1;
    min-height: 0;
}

.city-panel__city {
    width: 260px;
    flex-shrink: 0;
    padding-right: 12px;
    border-right-width: 1px;
    border-right-color: rgb(110, 84, 52);
}

.city-panel__tabs-side {
    flex-grow: 1;
    min-width: 0;
    padding-left: 12px;
}

.city-panel__tab-bar {
    flex-direction: row;
    flex-shrink: 0;
}

.city-panel__tab {
    margin: 0 4px 0 0;
    padding: 6px 12px;
    color: rgb(222, 210, 188);
    background-color: rgba(60, 44, 30, 0.9);
    border-width: 1px;
    border-radius: 0;
    border-color: rgb(110, 84, 52);
    font-size: 15px;
}

.city-panel__tab:hover {
    background-color: rgb(84, 62, 40);
}

.city-panel__tab--open,
.city-panel__tab--open:hover {
    color: rgb(240, 226, 196);
    background-color: rgb(110, 84, 52);
    -unity-font-style: bold;
}

/* A tab's page: what does not fit in it scrolls inside it. */
.city-panel__page {
    flex-grow: 1;
    min-height: 0;
    margin-top: 8px;
}

.market,
.buildings,
.city-panel__ships-scroll {
    flex-grow: 1;
    min-height: 0;
}

.market__ship-line {
    flex-direction: row;
    align-items: center;
    flex-shrink: 0;
    margin-bottom: 6px;
}

.market__row--header {
    flex-shrink: 0;
}

.market__ship-label {
    margin: 0 6px 0 0;
    padding: 0;
    color: rgb(222, 210, 188);
    font-size: 14px;
}

/* The player's ship that buys and sells, chosen among those in port. */
.market__ship-choice {
    width: 220px;
    margin: 0;
}

.market__ship-choice > .unity-base-field__input {
    color: rgb(222, 210, 188);
    background-color: rgba(60, 44, 30, 0.9);
    border-width: 1px;
    border-radius: 0;
    border-color: rgb(110, 84, 52);
    font-size: 14px;
}

.market__ship-choice:hover > .unity-base-field__input {
    background-color: rgb(84, 62, 40);
}

.market__ship-choice:disabled > .unity-base-field__input {
    color: rgb(140, 124, 100);
    background-color: rgba(60, 44, 30, 0.5);
}

/* The hold of the chosen ship, at the end of the line. */
.market__ship-line > .market__hold {
    margin-left: auto;
}

.market__hold {
    color: rgb(190, 164, 120);
    font-size: 14px;
    -unity-font-style: normal;
}

/* The header has the padding of the rows, so that its titles line up with them. */
.market__row {
    flex-direction: row;
    align-items: center;
    height: 32px;
    padding: 0 4px;
}

/* The good's icon, before its name, in the proportions of the icons (224 × 232). The header
   has an empty one, so that its title lines up with the names. */
.market__icon {
    width: 27px;
    height: 28px;
    margin-right: 6px;
    flex-shrink: 0;
    -unity-background-scale-mode: scale-to-fit;
}

.market__row--header {
    color: rgb(190, 164, 120);
}

/* Twenty goods do not fit in the tab: the rows scroll under their header. */
.market > .market__scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.market__cell {
    margin: 0;
    padding: 0;
    color: rgb(222, 210, 188);
    font-size: 14px;
}

.market__row--header .market__cell {
    color: rgb(190, 164, 120);
    font-size: 13px;
}

.market__cell--name {
    flex-grow: 1;
    flex-shrink: 1;
}

.market__cell--number {
    width: 62px;
    -unity-text-align: middle-right;
}

/* The two price columns: a header and, under it, the prices, which are buttons. The
   header's padding is the button's padding and border, so the texts line up. */
.market__cell--price {
    width: 68px;
    margin: 0 0 0 6px;
    padding: 0 6px;
    -unity-text-align: middle-right;
}

/* A price is the button that trades at it. One that cannot trade is disabled and reads
   as plain text: a market that is only read, a good the ship does not hold, an empty
   stock, a full hold or a lack of gold. Its price stays as readable as the others. */
.market__price {
    height: 22px;
    padding: 0 5px;
    border-width: 1px;
    border-radius: 0;
}

/* Under the pointer too: a disabled button is still hovered. */
.market__price:disabled,
.market__price:disabled:hover {
    background-color: rgba(0, 0, 0, 0);
    border-color: rgba(0, 0, 0, 0);
    opacity: 1;
}

.market__price:enabled {
    background-color: rgba(60, 44, 30, 0.9);
    border-color: rgb(110, 84, 52);
}

.market__price:enabled:hover {
    background-color: rgb(84, 62, 40);
    border-color: rgb(110, 84, 52);
}

.market__price:enabled:active {
    background-color: rgb(110, 84, 52);
    border-color: rgb(110, 84, 52);
}

/* The hold column only exists while a ship in port trades. */
.market__cell--trade {
    display: none;
}

.market--trading .market__cell--trade {
    display: flex;
}

/* The player's buildings: a text and the button that builds, one row each. The rows scroll
   above the costs when they do not fit in the tab. */
.buildings > .buildings__scroll {
    flex-grow: 1;
    flex-shrink: 1;
    min-height: 0;
}

.buildings__title {
    margin: 12px 0 4px 0;
    padding-bottom: 2px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(110, 84, 52);
    color: rgb(240, 226, 196);
    font-size: 16px;
    -unity-font-style: bold;
}

/* The first title is at the top of the tab. */
.buildings__title:first-child {
    margin-top: 0;
}

/* Padded rather than spaced, so that the stripes of the rows touch. */
.buildings__row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 2px 4px;
}

.buildings__text {
    flex-shrink: 1;
    margin: 0;
    padding: 0;
    color: rgb(222, 210, 188);
    font-size: 14px;
    white-space: normal;
}

.buildings__button {
    margin: 0 0 0 8px;
    padding: 2px 8px;
    color: rgb(222, 210, 188);
    background-color: rgba(60, 44, 30, 0.9);
    border-width: 1px;
    border-radius: 0;
    border-color: rgb(110, 84, 52);
    font-size: 14px;
}

.buildings__button:hover {
    background-color: rgb(84, 62, 40);
}

.buildings__button:active {
    background-color: rgb(110, 84, 52);
}

.buildings__button:disabled,
.buildings__button:disabled:hover {
    color: rgb(140, 124, 100);
    background-color: rgba(60, 44, 30, 0.5);
    opacity: 1;
}

.buildings__costs {
    flex-shrink: 0;
    margin-top: 4px;
    color: rgb(190, 164, 120);
    font-size: 13px;
    white-space: normal;
}
