.map-ui-root {
    flex-grow: 1;
}

.hover-label {
    position: absolute;
    padding: 2px 8px;
    color: rgb(240, 226, 196);
    background-color: rgba(20, 14, 10, 0.85);
    border-width: 1px;
    border-color: rgb(110, 84, 52);
    font-size: 16px;
    -unity-font-style: bold;
}

.city-panel {
    position: absolute;
    top: 24px;
    right: 24px;
    width: 340px;
    padding: 16px;
    background-color: rgba(24, 17, 12, 0.94);
    border-width: 2px;
    border-color: rgb(110, 84, 52);
}

.city-panel__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
}

.city-panel__name {
    flex-shrink: 1;
    color: rgb(240, 226, 196);
    font-size: 24px;
    -unity-font-style: bold;
    white-space: normal;
}

.city-panel__close {
    width: 28px;
    height: 28px;
    margin: 0;
    padding: 0;
}

.city-panel__tag {
    color: rgb(190, 164, 120);
    font-size: 14px;
}

.city-panel__description {
    margin-top: 12px;
    color: rgb(222, 210, 188);
    font-size: 15px;
    white-space: normal;
}

.city-panel__section {
    margin-top: 16px;
    margin-bottom: 4px;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: rgb(110, 84, 52);
    color: rgb(240, 226, 196);
    font-size: 16px;
    -unity-font-style: bold;
}

.city-panel__empty {
    color: rgb(140, 124, 100);
    font-size: 14px;
    -unity-font-style: italic;
}

.city-panel__ship {
    margin: 2px 0;
    padding: 6px 8px;
    color: rgb(222, 210, 188);
    background-color: rgba(60, 44, 30, 0.9);
    border-width: 1px;
    border-radius: 0;
    border-color: rgb(110, 84, 52);
    font-size: 15px;
    -unity-text-align: middle-left;
}

.city-panel__ship:hover {
    background-color: rgb(84, 62, 40);
}

.city-panel__ship:active {
    background-color: rgb(110, 84, 52);
}

.city-panel__ship--selected,
.city-panel__ship--selected:hover {
    color: rgb(24, 17, 12);
    background-color: rgb(255, 140, 51);
    border-color: rgb(240, 226, 196);
}
