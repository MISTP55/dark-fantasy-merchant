/* The panel's frame, title and close button are in InfoPanel.uss. */

/* Centers the panel under the date and its button. */
.debug-panel-root {
    flex-grow: 1;
    align-items: center;
    padding-top: 110px;
    padding-bottom: 16px;
}

/* Most of the screen under the date, whatever its tab: the charts need room. Only a page's content scrolls. */
.debug-panel {
    width: 90%;
    height: 100%;
}

.debug-cities__legend {
    margin-bottom: 8px;
    color: rgb(190, 164, 120);
    font-size: 13px;
}

.debug-cities__scroll {
    flex-shrink: 1;
}

/* The city's columns, which stay in place, beside the goods', which scroll sideways. Rows have one height, so they line up. */
.debug-cities__table {
    flex-direction: row;
    align-items: flex-start;
}

.debug-cities__fixed-columns {
    flex-shrink: 0;
}

.debug-cities__good-columns {
    flex-shrink: 1;
}

.debug-cities__row {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    height: 24px;
}

.debug-cities__cell {
    flex-shrink: 0;
    margin: 0;
    padding: 0 8px;
    color: rgb(222, 210, 188);
    font-size: 14px;
    -unity-text-align: middle-right;
}

.debug-cities__row--header .debug-cities__cell {
    color: rgb(190, 164, 120);
    font-size: 13px;
}

.debug-cities__row--total {
    margin-top: 4px;
    border-top-width: 1px;
    border-top-color: rgb(110, 84, 52);
}

.debug-cities__row--total .debug-cities__cell {
    color: rgb(240, 226, 196);
    -unity-font-style: bold;
}

.debug-cities__cell--name {
    width: 150px;
    -unity-text-align: middle-left;
}

.debug-cities__cell--population {
    width: 110px;
}

.debug-cities__cell--beggars {
    width: 120px;
}

.debug-cities__cell--class {
    width: 150px;
}

.debug-cities__cell--growth-since-start {
    width: 110px;
}

.debug-cities__cell--stock {
    width: 80px;
    border-left-width: 1px;
    border-left-color: rgb(110, 84, 52);
}

.debug-cities__cell--figure {
    width: 140px;
}

/* Wide enough for a total: "256/1 020 +185". */
.debug-cities__cell--workers {
    width: 130px;
}

.debug-cities__cell--houses {
    width: 150px;
}

.debug-cities__cell--threshold {
    width: 80px;
}

.debug-cities__cell--price {
    width: 70px;
}

.debug-cities__cell--under-way {
    width: 110px;
}

/* As wide as the name, the population, the beggars, the three classes and the growth. */
.debug-cities__cell--city-group {
    width: 940px;
}

/* As wide as the stock, the three figures and the workers of a good. */
.debug-cities__row--header .debug-cities__cell--good-group {
    width: 630px;
    border-left-width: 1px;
    border-left-color: rgb(110, 84, 52);
    color: rgb(240, 226, 196);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Between the title and the close button. */
.debug-panel__tabs {
    flex-direction: row;
    flex-grow: 1;
    margin-left: 24px;
}

.debug-panel .debug-panel__tab {
    height: 28px;
    margin: 0 4px 0 0;
    padding: 0 12px;
    color: rgb(190, 164, 120);
    background-color: rgb(44, 32, 22);
    border-width: 1px;
    border-color: rgb(110, 84, 52);
    border-radius: 0;
}

/* Prefixed by the panel: the theme's own hover and active rules must not win, their grey hides the text. */
.debug-panel .debug-panel__tab:hover:enabled {
    color: rgb(240, 226, 196);
    background-color: rgb(62, 46, 30);
}

.debug-panel .debug-panel__tab:active:enabled {
    background-color: rgb(80, 60, 38);
}

.debug-panel .debug-panel__tab--selected,
.debug-panel .debug-panel__tab--selected:hover:enabled {
    color: rgb(240, 226, 196);
    background-color: rgb(96, 72, 44);
    border-color: rgb(190, 164, 120);
    -unity-font-style: bold;
}

/* Fills the panel and shrinks with it, so that its content scrolls. */
.debug-panel__page {
    flex-grow: 1;
    flex-shrink: 1;
}

/* The sub-tabs of a tab, over its pages. */
.debug-panel__subtabs {
    flex-direction: row;
    flex-shrink: 0;
    margin-bottom: 8px;
}

.debug-panel .debug-panel__subtab {
    height: 24px;
    font-size: 13px;
}

/* In the header, before the speed. */
.debug-panel__horizon {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    margin-right: 12px;
}

.debug-panel__horizon-label {
    width: auto;
}

/* A drop-down list of the panel, in its colors. */
.debug-panel__dropdown {
    width: 150px;
    margin: 0;
}

.debug-panel__dropdown--wide {
    width: 240px;
}

.debug-panel__toolbar .debug-panel__dropdown {
    margin-left: 16px;
    margin-bottom: 8px;
}

.debug-panel__dropdown .unity-base-popup-field__input {
    color: rgb(222, 210, 188);
    background-color: rgb(44, 32, 22);
    border-color: rgb(110, 84, 52);
    border-radius: 0;
}

.debug-ships__cell--name {
    width: 210px;
    -unity-text-align: middle-left;
}

.debug-ships__cell--text {
    width: 130px;
    -unity-text-align: middle-left;
}

.debug-ships__cell--number {
    width: 100px;
}

/* The legend of a tab and, at its right, the tab's buttons. */
.debug-panel__toolbar {
    flex-direction: row;
    flex-shrink: 0;
    justify-content: space-between;
    align-items: center;
}

/* Prefixed by the panel, like the tabs: the theme's grey hides the text. */
.debug-panel .debug-panel__button {
    flex-shrink: 0;
    height: 22px;
    margin: 0;
    padding: 0 10px;
    color: rgb(222, 210, 188);
    font-size: 13px;
    background-color: rgb(44, 32, 22);
    border-width: 1px;
    border-color: rgb(110, 84, 52);
    border-radius: 0;
}

.debug-panel .debug-panel__button:hover:enabled {
    color: rgb(240, 226, 196);
    background-color: rgb(62, 46, 30);
}

.debug-panel .debug-panel__button:active:enabled {
    background-color: rgb(96, 72, 44);
}

/* In the header, between the tabs and the close button. */
.debug-panel__speed {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    margin-right: 12px;
}

/* As wide as its longest text, "Vitesse ×600": the slider does not move while it is dragged. */
.debug-panel__speed-label {
    width: 96px;
    margin: 0 8px 0 0;
    padding: 0;
    color: rgb(222, 210, 188);
    font-size: 13px;
    -unity-text-align: middle-right;
}

.debug-panel__speed-slider {
    width: 200px;
    margin: 0;
}

/* Without a height, the drag area is flat and the tracker, centered on it, sits above the label. */
.debug-panel__speed-slider #unity-drag-container {
    height: 24px;
}

/* The theme's tracker and dragger, in the panel's colors. */
.debug-panel__speed-slider #unity-tracker {
    background-color: rgb(44, 32, 22);
    border-color: rgb(110, 84, 52);
}

.debug-panel__speed-slider #unity-dragger {
    background-color: rgb(190, 164, 120);
    border-color: rgb(240, 226, 196);
}

.debug-panel__toolbar .debug-panel__button {
    margin-left: 16px;
    margin-bottom: 8px;
}

.debug-ships__cell--action {
    flex-shrink: 0;
    width: 90px;
    padding-left: 8px;
}

/* A chart of days: its title over its plot, drawn by TimeSeriesChart. */
.debug-chart {
    flex-direction: column;
    flex-shrink: 0;
    height: 130px;
    margin: 0 6px 6px 0;
    padding: 4px 6px;
    background-color: rgb(35, 29, 24);
    border-width: 1px;
    border-color: rgb(58, 48, 41);
}

.debug-chart--large {
    flex-grow: 1;
    height: auto;
    min-height: 300px;
}

.debug-chart__title {
    flex-shrink: 0;
    margin: 0 0 2px 0;
    padding: 0;
    color: rgb(190, 164, 120);
    font-size: 12px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.debug-chart__plot {
    flex-grow: 1;
}

/* Over the plot, at the pointer's height: on the side away from the pointer. */
.debug-chart__tooltip {
    position: absolute;
    top: 0;
    padding: 4px 6px;
    color: rgb(240, 226, 196);
    font-size: 12px;
    white-space: nowrap;
    background-color: rgba(24, 17, 12, 0.94);
    border-width: 1px;
    border-color: rgb(110, 84, 52);
}

/* The curves of a city: the list of the cities at the left, their charts at the right. */
.debug-curves {
    flex-direction: row;
}

.debug-curves__cities {
    flex-shrink: 0;
    width: 160px;
    margin-right: 8px;
}

.debug-panel .debug-curves__city {
    height: 22px;
    margin: 0;
    padding: 0 8px;
    color: rgb(190, 164, 120);
    font-size: 13px;
    -unity-text-align: middle-left;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-radius: 0;
}

.debug-panel .debug-curves__city.list-row--alternate {
    background-color: rgba(240, 226, 196, 0.01);
}

.debug-panel .debug-curves__city:hover:enabled {
    color: rgb(240, 226, 196);
    background-color: rgb(62, 46, 30);
}

.debug-panel .debug-curves__city.debug-panel__tab--selected {
    color: rgb(240, 226, 196);
    background-color: rgb(96, 72, 44);
    -unity-font-style: bold;
}

.debug-curves__charts {
    flex-grow: 1;
    flex-shrink: 1;
}

.debug-curves__section {
    margin: 4px 0;
    color: rgb(190, 164, 120);
    font-size: 13px;
    -unity-font-style: bold;
}

.debug-curves__grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.debug-chart--third {
    width: 32.5%;
    height: 170px;
}

.debug-chart--quarter {
    width: 24.2%;
}
