/* The panel's frame, title and close button are in InfoPanel.uss. */

/* Centers the panel under the date and its button. */
.debug-panel-root {
    flex-grow: 1;
    align-items: center;
    padding-top: 110px;
}

/* A panel as wide as its table, scrolled when it does not fit. */
.debug-panel {
    width: auto;
    max-width: 96%;
    max-height: 70%;
}

.debug-cities__legend {
    margin-bottom: 8px;
    color: rgb(190, 164, 120);
    font-size: 13px;
}

.debug-cities__scroll {
    flex-shrink: 1;
}

.debug-cities__row {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    height: 24px;
}

.debug-cities__cell {
    flex-shrink: 0;
    margin: 0;
    padding: 0 8px;
    color: rgb(222, 210, 188);
    font-size: 14px;
    -unity-text-align: middle-right;
}

.debug-cities__row--header .debug-cities__cell {
    color: rgb(190, 164, 120);
    font-size: 13px;
}

.debug-cities__row--total {
    margin-top: 4px;
    border-top-width: 1px;
    border-top-color: rgb(110, 84, 52);
}

.debug-cities__row--total .debug-cities__cell {
    color: rgb(240, 226, 196);
    -unity-font-style: bold;
}

.debug-cities__cell--name {
    width: 150px;
    -unity-text-align: middle-left;
}

.debug-cities__cell--population {
    width: 100px;
}

.debug-cities__cell--growth {
    width: 110px;
}

.debug-cities__cell--stock {
    width: 80px;
    border-left-width: 1px;
    border-left-color: rgb(110, 84, 52);
}

.debug-cities__cell--figure {
    width: 140px;
}

/* As wide as the name, the population and its growth. */
.debug-cities__cell--city-group {
    width: 360px;
}

/* As wide as the stock and the three figures of a good. */
.debug-cities__row--header .debug-cities__cell--good-group {
    width: 500px;
    border-left-width: 1px;
    border-left-color: rgb(110, 84, 52);
    color: rgb(240, 226, 196);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* Between the title and the close button. */
.debug-panel__tabs {
    flex-direction: row;
    flex-grow: 1;
    margin-left: 24px;
}

.debug-panel .debug-panel__tab {
    height: 28px;
    margin: 0 4px 0 0;
    padding: 0 12px;
    color: rgb(190, 164, 120);
    background-color: rgb(44, 32, 22);
    border-width: 1px;
    border-color: rgb(110, 84, 52);
    border-radius: 0;
}

/* Prefixed by the panel: the theme's own hover and active rules must not win, their grey hides the text. */
.debug-panel .debug-panel__tab:hover:enabled {
    color: rgb(240, 226, 196);
    background-color: rgb(62, 46, 30);
}

.debug-panel .debug-panel__tab:active:enabled {
    background-color: rgb(80, 60, 38);
}

.debug-panel .debug-panel__tab--selected,
.debug-panel .debug-panel__tab--selected:hover:enabled {
    color: rgb(240, 226, 196);
    background-color: rgb(96, 72, 44);
    border-color: rgb(190, 164, 120);
    -unity-font-style: bold;
}

/* Shrinks with the panel, so that its table scrolls. */
.debug-panel__page {
    flex-shrink: 1;
}

.debug-ships__cell--name {
    width: 210px;
    -unity-text-align: middle-left;
}

.debug-ships__cell--text {
    width: 130px;
    -unity-text-align: middle-left;
}

.debug-ships__cell--number {
    width: 100px;
}

/* The legend of a tab and, at its right, the tab's buttons. */
.debug-panel__toolbar {
    flex-direction: row;
    flex-shrink: 0;
    justify-content: space-between;
    align-items: center;
}

/* Prefixed by the panel, like the tabs: the theme's grey hides the text. */
.debug-panel .debug-panel__button {
    flex-shrink: 0;
    height: 22px;
    margin: 0;
    padding: 0 10px;
    color: rgb(222, 210, 188);
    font-size: 13px;
    background-color: rgb(44, 32, 22);
    border-width: 1px;
    border-color: rgb(110, 84, 52);
    border-radius: 0;
}

.debug-panel .debug-panel__button:hover:enabled {
    color: rgb(240, 226, 196);
    background-color: rgb(62, 46, 30);
}

.debug-panel .debug-panel__button:active:enabled {
    background-color: rgb(96, 72, 44);
}

.debug-panel__toolbar .debug-panel__button {
    margin-left: 16px;
    margin-bottom: 8px;
}

.debug-ships__cell--action {
    flex-shrink: 0;
    width: 90px;
    padding-left: 8px;
}
